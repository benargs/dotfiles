#!/usr/bin/env bash
# install [--headless] [--deps] [--hard] [stow args...]   link the dotfiles into ~ (re-stow, so safe to rerun).
# home/ is everything that works over ssh, desktop/ is the sway session on top. --headless skips
# desktop/, --deps installs the packages each half needs first, --hard copies the files instead of
# linking them, so the repo can be deleted afterwards. Anything else goes to stow, e.g.
# `./install -n -v` for a dry run or `./install -D` to unlink.
set -euo pipefail
cd "$(dirname "$0")"

home_deps=(stow vim tig git curl gcc zsh fzf tmux neovim jq glow btop tree-sitter-cli)
desktop_deps=(
  kitty
  sway swaybg swayidle swaylock waybar mako fuzzel
  grim slurp wl-clipboard swappy playerctl
  wf-recorder brightnessctl libnotify xdg-utils
  xdg-desktop-portal-wlr pipewire wireplumber pulseaudio-utils
  bluez NetworkManager upower
  jetbrains-mono-fonts fontawesome-6-free-fonts adw-gtk3-theme
)

packages=(home desktop) deps=0 hard=0 stow_args=()
for arg; do
  case $arg in
    --headless) packages=(home) ;;
    --deps) deps=1 ;;
    --hard) hard=1 ;;
    *) stow_args+=("$arg") ;;
  esac
done

if (( deps )); then
  want=("${home_deps[@]}")
  [[ " ${packages[*]} " == *" desktop "* ]] && want+=("${desktop_deps[@]}")
  if command -v dnf >/dev/null; then
    sudo dnf install -y "${want[@]}"
  elif command -v apt-get >/dev/null; then
    want=("${want[@]/jetbrains-mono-fonts/fonts-jetbrains-mono}")
    want=("${want[@]/fontawesome-6-free-fonts/fonts-font-awesome}")
    want=("${want[@]/libnotify/libnotify-bin}")
    want=("${want[@]/NetworkManager/network-manager}")
    sudo apt-get install -y "${want[@]}"
  else
    echo "no dnf or apt-get, install these yourself: ${want[*]}" >&2; exit 1
  fi
fi

if (( hard )); then
  (( ${#stow_args[@]} == 0 )) || { echo "--hard doesn't take stow args: ${stow_args[*]}" >&2; exit 1; }
  for p in "${packages[@]}"; do cp -a --remove-destination "$p/." ~/; done
else
  stow -R "${stow_args[@]}" "${packages[@]}"
fi
echo "Installation complete! See 'next steps' in README.md"
